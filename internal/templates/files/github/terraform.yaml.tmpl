## This file is auto generated by tfskel: https://github.com/ishuar/tfskel
## This workflow runs Terraform plan & apply for envs/{{.Env}}/{{.Region}}/{{.AppDir}}.
##
## - On pull_request : plans only and posts output as a PR comment. set auto_apply to true to enable auto-apply on PRs.
## - On push to main : plans and *always* automatically applies changes.
## - On workflow_dispatch : manually trigger with optional auto_apply.
##
## Delegates all logic to reusable-terraform-plan-apply.yaml.
## Expects an AWS OIDC role and a GitHub environment '{{.Env}}' with appropriate protection rules.

name: TF plan & apply envs/{{.Env}}/{{.Region}}/{{.AppDir}} terraform files
on:
  pull_request:
    branches:
      - main
    paths:
      - 'envs/{{.Env}}/{{.Region}}/{{.AppDir}}/**'
      - '.github/workflows/{{.WorkflowFileName}}'

  push:
    branches:
      - main
    paths:
      - 'envs/{{.Env}}/{{.Region}}/{{.AppDir}}/**'
      - '.github/workflows/{{.WorkflowFileName}}'

  ## For manual trigger on github UI
  workflow_dispatch:
    inputs:
      auto_apply:
        type: boolean
        required: false
        default: false
        description: Set to true to auto-apply terraform plan. Keep false for production unless using approval gates.
      tfskel_version:
        type: string
        required: false
        default: 'latest'
        description: The version of tfskel to use for plan analysis.

jobs:
  terraform-plan-apply:
    uses: ./.github/workflows/reusable-terraform-plan-apply.yaml
    permissions:
      pull-requests: write
      contents: read
      id-token: write
    with:
      terraform_files_path: 'envs/{{.Env}}/{{.Region}}/{{.AppDir}}'
      aws_region: {{.Region}}
      aws_role_to_assume: "{{.AWSRoleArn}}" # This role should pre-exist and have necessary permissions to perform terraform actions
      environment: {{.Env}}
      auto_apply: ${{"{{"}} inputs.auto_apply || false {{"}}"}} # Set to true to enable auto-apply on PR. Keep false for production unless using approval gates.
      tfskel_version: ${{"{{"}} inputs.tfskel_version || 'latest' {{"}}"}}
