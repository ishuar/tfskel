# mise: dev tool manager — pins tool versions, runs post-install hooks,
# and trusts per-environment configs so `mise install` is all you need.
# https://mise.jdx.dev

min_version = "2024.9.0"

[settings]
experimental = true

[tools]
terraform = "{{ .TerraformVersion | stripConstraint }}"
{{- range miseTools }}
{{ .Name }} = "{{ .Version }}"
{{- end }}

[hooks]
# After mise install: set up pre-commit hooks and trust mise configs
postinstall = """
pre-commit install --install-hooks
mise trust .
{{- range .Environments }}
[ -f "./envs/{{ . }}/.mise.toml" ] && mise trust "./envs/{{ . }}/.mise.toml"
{{- end }}
"""
