{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":semanticCommits",
    "schedule:weekly"
  ],
  "timezone": "Europe/Berlin",
  "semanticCommitScope": null,
  "labels": ["dependencies"],
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "description": "Go modules: build type (shown in changelog), group non-major bumps",
      "matchManagers": ["gomod"],
      "semanticCommitType": "build",
      "matchUpdateTypes": ["minor", "patch", "digest"],
      "groupName": "go modules"
    },
    {
      "description": "Go toolchain directive bumps stay separate so CI matrix can be reviewed alongside",
      "matchManagers": ["gomod"],
      "matchDepTypes": ["golang"],
      "semanticCommitType": "build",
      "groupName": null
    },
    {
      "description": "GitHub Actions: ci type (hidden from changelog), group everything non-major",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "github actions"
    },
    {
      "description": "Tool versions pinned as plain strings in workflows",
      "matchManagers": ["custom.regex"],
      "semanticCommitType": "ci"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "golangci-lint version under golangci/golangci-lint-action `with.version`",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "uses: golangci/golangci-lint-action@[^\\n]*\\n\\s+with:\\n(?:\\s+[^\\n]*\\n)*?\\s+version:\\s*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "mise version under jdx/mise-action `with.version` (tag has v prefix, workflow does not)",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "uses: jdx/mise-action@[^\\n]*\\n\\s+with:\\n(?:\\s+[^\\n]*\\n)*?\\s+version:\\s*(?<currentValue>\\d{4}\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "jdx/mise",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
